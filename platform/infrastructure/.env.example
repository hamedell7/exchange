# Local development only. Never use these values in production.
POSTGRES_ADMIN_PASSWORD=local_postgres_dev
REDIS_PASSWORD=local_redis_dev
RABBITMQ_USER=exchange_app
RABBITMQ_PASSWORD=local_rabbitmq_dev

# API Gateway (host port and Docker DNS destinations)
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_HOST=identity-service
IDENTITY_SERVICE_PORT=8000
WALLET_SERVICE_HOST=wallet-service
WALLET_SERVICE_PORT=8000
TRADING_SERVICE_HOST=trading-service
TRADING_SERVICE_PORT=8000
MARKET_DATA_SERVICE_HOST=market-data-service
MARKET_DATA_SERVICE_PORT=8000

IDENTITY_DB_USERNAME=identity_app
IDENTITY_DB_DATABASE=identity_db
IDENTITY_DB_PASSWORD=local_identity_dev

WALLET_DB_USERNAME=wallet_app
WALLET_DB_DATABASE=wallet_db
WALLET_DB_PASSWORD=local_wallet_dev

TRADING_DB_USERNAME=trading_app
TRADING_DB_DATABASE=trading_db
TRADING_DB_PASSWORD=local_trading_dev

MARKET_DATA_DB_USERNAME=market_data_app
MARKET_DATA_DB_DATABASE=market_data_db
MARKET_DATA_DB_PASSWORD=local_market_data_dev
