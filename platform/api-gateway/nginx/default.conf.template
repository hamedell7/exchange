# Nginx API Gateway template.
# Only upstream host/port variables are substituted by the official image entrypoint.

limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=conn_per_ip:10m;

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # Docker embedded DNS. Resolve service names at request time so the Gateway
    # can start before the independently managed Laravel containers.
    resolver 127.0.0.11 ipv6=off valid=10s;

    client_max_body_size 1m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    send_timeout 30s;

    limit_conn conn_per_ip 30;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Request-ID $request_id always;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    location = / {
        default_type application/json;
        return 200 '{"service":"exchange-api-gateway","status":"ok"}';
    }

    location / {
        default_type application/json;
        return 404 '{"error":{"code":"route_not_found","message":"Route not found"}}';
    }

    # Identity owns authentication, credentials, sessions and identity permissions.
    location ^~ /api/v1/identity/ {
        set $identity_backend ${IDENTITY_SERVICE_HOST}:${IDENTITY_SERVICE_PORT};
        limit_req zone=api_per_ip burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://$identity_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }

    # Trading owns markets, orders and executions.
    location ^~ /api/v1/trading/ {
        set $trading_backend ${TRADING_SERVICE_HOST}:${TRADING_SERVICE_PORT};
        limit_req zone=api_per_ip burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://$trading_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }

    # Wallet owns balances, ledger entries, holds and transfers.
    location ^~ /api/v1/wallet/ {
        set $wallet_backend ${WALLET_SERVICE_HOST}:${WALLET_SERVICE_PORT};
        limit_req zone=api_per_ip burst=40 nodelay;
        limit_req_status 429;

        proxy_pass http://$wallet_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;

        proxy_connect_timeout 3s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
    }
}
