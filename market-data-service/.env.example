APP_NAME=market-data-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=market_data_db
DB_USERNAME=market_data_app
DB_PASSWORD=local_market_data_dev
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=local_redis_dev
REDIS_PORT=6379
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Internal Docker DNS used by Laravel publishers and the Binance streamer.
REVERB_HOST=app
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb listens on this interface and port inside the container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_HTTP_TIMEOUT=30
CMC_WS_URL=wss://pro-stream.coinmarketcap.com/v1
# Fallback interval; CMC may override it in its welcome message.
CMC_WS_PING_INTERVAL_MS=10000
BINANCE_SPOT_BASE_URL=https://data-api.binance.vision
BINANCE_SPOT_WS_URL=wss://data-stream.binance.vision:443/ws/!ticker_1d@arr
BINANCE_HTTP_TIMEOUT=20
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
NOBITEX_HTTP_TIMEOUT=15
