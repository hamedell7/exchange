APP_NAME=market-data-service
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stderr
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=market_data_db
DB_USERNAME=market_data_app
DB_PASSWORD=local_market_data_dev
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=local_redis_dev
REDIS_PORT=6379
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Internal Docker DNS used by Laravel publishers and the Nobitex streamer.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_MAX_REQUEST_SIZE=1048576
REVERB_APP_MAX_MESSAGE_SIZE=1048576
# CMC REST is only required for importing/updating the static asset catalog.
CMC_API_KEY=
CMC_BASE_URL=https://pro-api.coinmarketcap.com
CMC_HTTP_TIMEOUT=30
NOBITEX_BASE_URL=https://apiv2.nobitex.ir
NOBITEX_WS_URL=wss://ws.nobitex.ir/connection/websocket
NOBITEX_HTTP_TIMEOUT=15
