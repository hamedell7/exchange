# Optional public API origin. Keep empty to use the current browser origin.
# During development Vite proxies /api requests to the local API Gateway.
VITE_API_ORIGIN=

# Local API Gateway used by the Vite development proxy.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Public Reverb connection for live market prices. Copy only the app key,
# never the Reverb secret, into the frontend environment.
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8082
VITE_REVERB_SCHEME=ws
VITE_REVERB_APP_KEY=
